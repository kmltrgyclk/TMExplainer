{
	"name": "tmexplainer",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync || echo \"\"",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"pretrain": "esbuild scripts/pretrain.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/pretrain.mjs && node node_modules/.cache/pretrain.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3": "^7.4.3",
		"@types/node": "^22.20.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^6.4.4",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"gsap": "^3.15.0",
		"katex": "^0.19.0"
	}
}
